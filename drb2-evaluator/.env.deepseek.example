# Copy to .env and fill the key locally. Never commit or share .env.

OPENAI_API_URL=https://api.deepseek.com/chat/completions
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-pro
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=32768
OPENAI_MAX_TOKENS_PARAM=max_tokens
OPENAI_THINKING=disabled
OPENAI_TIMEOUT=600

PDF_DIR=report
OUT_JSONL=result.jsonl
TASKS_JSONL=tasks_and_rubrics.jsonl
CHUNK_SIZE=50
MAX_WORKERS=1
MAX_RETRIES=5
MAX_PAPER_CHARS=150000
LOG_FILE=run_evaluation.log
